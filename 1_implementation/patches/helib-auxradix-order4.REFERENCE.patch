+static NTL::xdouble NoiseNorm(NTL::xdouble noise1,
+                              NTL::xdouble noise2,
+                              long e1,
+                              long e2,
+                              long p)
+{
+  return noise1 * std::abs(balRem(e1, p)) + noise2 * std::abs(balRem(e2, p));
+}
