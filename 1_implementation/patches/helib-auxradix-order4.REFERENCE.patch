+void ThinEvalMap::apply(Ctxt& ctxt0, Ctxt& ctxt1) const
+{
+  if (!invert) { // forward direction
+    for (long i = matvec.length() - 1; i >= 0; i--) {
+      if (matvec[i]) {
+        matvec[i]->mul(ctxt0);
+        matvec[i]->mul(ctxt1);
+      }
+    }
+  } else { // inverse transformation
+    for (long i = 0; i < matvec.length(); i++) {
+      if (matvec[i]) {
+        matvec[i]->mul(ctxt0);
+        matvec[i]->mul(ctxt1);
+      }
+    }
+    traceMap(ctxt0);
+    traceMap(ctxt1);
+  }
+}
