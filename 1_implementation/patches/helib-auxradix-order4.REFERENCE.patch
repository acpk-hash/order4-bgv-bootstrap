+void Ctxt::reLinearizeInto(Ctxt& out, long keyID, bool toNewBootKey)
+{
+  HELIB_TIMER_START;
+
+  assertEq(&context, &out.context, "Context mismatch");
+  assertEq(&pubKey, &out.pubKey, "Public key mismatch");
+
+  if (this->isEmpty())
+    return;
+
+  if (this->inCanonicalForm(keyID)) {
+    out += *this;
+    return;
+  }
+
+  assertFalse(toNewBootKey && (primeSet != IndexSet(context.getIndexQks())),
+              "only qKS is expected");
+  if (!toNewBootKey)
+    dropSmallAndSpecialPrimes();
+
+  relin_CKKS_adjust();
+
+  long g = ptxtSpace;
+  IndexSet newSpecialPrimeSet;
+  if (toNewBootKey)
+    newSpecialPrimeSet.insert(context.getIndexR());
+  else
+    newSpecialPrimeSet = context.getSpecialPrimes();
+
+  double logProd = context.logOfProduct(newSpecialPrimeSet);
+  IndexSet targetPrimeSet = primeSet | newSpecialPrimeSet;
+
+  if (out.isEmpty()) {
+    out.primeSet = targetPrimeSet;
+    out.ptxtSpace = ptxtSpace;
+    out.intFactor = intFactor;
+    out.ptxtMag = ptxtMag;
+    out.ratFactor = ratFactor * NTL::xexp(logProd);
+  } else {
+    if (out.primeSet != targetPrimeSet || out.ptxtSpace != ptxtSpace ||
+        out.intFactor != intFactor) {
+      reLinearize(keyID, toNewBootKey);
+      out += *this;
+      return;
+    }
+  }
+
+  out.noiseBound += noiseBound * NTL::xexp(logProd);
+
+  for (CtxtPart& part : parts) {
+    if (part.skHandle.isOne() || part.skHandle.isBase(keyID)) {
+      CtxtPart pp = part;
+      pp.addPrimesAndScale(newSpecialPrimeSet);
+      out.addPart(pp, /*matchPrimeSet=*/true);
+      continue;
+    }
+
+    const KeySwitch& W = (keyID >= 0)
+                             ? pubKey.getKeySWmatrix(part.skHandle, keyID)
+                             : pubKey.getAnyKeySWmatrix(part.skHandle);
+    assertTrue(W.toKeyID >= 0, "No key-switching matrix exists");
+
+    if (g > 1) {
+      out.reducePtxtSpace(W.ptxtSpace);
+      g = out.ptxtSpace;
+    }
+
+    out.keySwitchPart(part, W, toNewBootKey);
+  }
+}
+
 Ctxt& Ctxt::cleanUp()
 {
   reLinearize();
@@ -3281,4 +3352,85 @@ void extractImPart(Ctxt& c)
