+          long in = base + q + m * s;
+          for (long k : range(4)) {
+            long out = base + k * m + q;
+            RX val =
+                rxMulMod<type>(rxPowerMod<type>(root, q * k, G),
+                               rxPowerMod<type>(omega4, s * k, G),
