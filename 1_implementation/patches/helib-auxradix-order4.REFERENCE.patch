+void Ctxt::addConstant(const NTL::ZZX& poly, double size)
+{
+  if (size < 0 && !isCKKS()) {
+    size = NTL::conv<double>(
+        embeddingLargestCoeff(poly, getContext().getZMStar()));
+  }
+
+  addConstant(DoubleCRT(poly, context, primeSet), size);
+}
